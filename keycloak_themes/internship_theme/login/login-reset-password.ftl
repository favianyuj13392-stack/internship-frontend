        <form id="kc-reset-password-form" class="form reset-password ${properties.kcFormClass!}" action="${url.loginAction}" method="post">
            <span class="login100-form-title p-b-49">
                      Olvidaste tu contraseña?
                  </span>
            
            <div class="reset-password-field ${properties.kcFormGroupClass!}">
                
                <div class="${properties.kcLabelWrapperClass!}">
                    <label for="username" class="${properties.kcLabelClass!}"><#if !realm.loginWithEmailAllowed>${msg("username")}<#elseif !realm.registrationEmailAsUsername><#else>${msg("email")}</#if></label>
                </div>
                <div class="kcFormGroupClass ${properties.kcInputWrapperClass!}">
                    <span class="label-input100">Username o correo electrónico</span>
                        <input tabindex="1" id="username" class="kcInputClass form-control ${properties.kcInputClass!}" name="username" placeholder="Ingresa tu username" type="text" autofocus/>
                        <span class="focus-input100" data-symbol="&#xf206;"></span>
                    
                </div>
            </div>

            <div class="${properties.kcFormGroupClass!} row">
                <div id="kc-form-options" class="${properties.kcFormOptionsClass!} col-xs-5">
                    <div class="${properties.kcFormOptionsWrapperClass!}">
                        <span>
                            <a class="btn btn-default btn-flat btn-block" href="${url.loginUrl}">Regresar al login</a>
                        </span>
                    </div>
                </div>
                <br>
                <div id="kc-form-buttons" class="${properties.kcFormButtonsClass!} col-xs-7">
                    <div class="login100-form-bgbtn"></div>
                    <input type="hidden" id="id-hidden-input" name="credentialId">
                                     
                    <input tabindex="4" id="kc-login" class="kcButtonClass" type="submit" value="Enviar"/>
                </div>

            </div>
        </form>
<br>
    <#elseif section = "info" >
        <hr />
        Ingrese su username o correo electrónico y le mandaremos las instrucciones para crear su nueva contraseña.
    </#if>
</@layout.registrationLayout>